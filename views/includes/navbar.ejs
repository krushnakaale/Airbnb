<style>
  .search-input {
    border-radius: 2rem; /* smoother rounded edges */
    padding: 0.5rem 1.5rem;
    font-size: 1rem;
    border: 1px solid #ddd;
    transition: all 0.3s ease;
  }

  .search-input:focus {
    outline: none;
    box-shadow: 0 0 5px rgba(254, 66, 77, 0.5);
    border-color: #fe424d;
  }

  /* Search button */
  .btn-search {
    background-color: #fe424d;
    color: #fff;
    border-radius: 2rem;
    padding: 0.5rem 1.5rem;
    transition: all 0.3s ease;
  }

  .btn-search:hover {
    background-color: #e63946;
    color: #fff;
  }

  /* Live search dropdown */
  #search-results {
    max-height: 300px;
    overflow-y: auto;
    z-index: 1050; /* above other content */
    border-radius: 0 0 1rem 1rem;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  #search-results a {
    padding: 0.5rem 1rem;
    display: block;
    text-decoration: none;
    color: #333;
    transition: background 0.2s;
  }

  #search-results a:hover {
    background-color: #f1f1f1;
  }
</style>

<nav
  class="navbar navbar-expand-md bg-body-light border-bottom sticky-top container-fluid"
>
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"
      ><i class="fa-solid fa-compass"></i
    ></a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <!-- Fixed: Added action and method, plus name="q" for input -->
      <div
        class="navbar-nav mx-auto position-relative"
        style="max-width: 400px; width: 100%"
      >
        <input
          class="form-control me-2 search-input"
          type="search"
          id="live-search"
          placeholder="Search destinations"
          aria-label="Search"
        />
        <div
          id="search-results"
          class="position-absolute bg-white border mt-1 w-100"
        ></div>
      </div>

      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Airbnb your home</a>
        <% if (!currUser) { %>
        <a class="nav-link" href="/signup"><b>Sign up</b></a>
        <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } else { %>
        <span class="nav-link disabled"><%= currUser.username %></span>
        <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
